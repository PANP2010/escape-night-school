{
  "name": "escape-night-school-apps",
  "version": "0.6.3",
  "private": true,
  "description": "逃离夜校 — desktop and Android distribution",
  "author": "Escape Night School",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "prepare:game": "node scripts/prepare-game.mjs",
    "prepare:ui": "node scripts/prepare-ui.mjs",
    "icons": "node scripts/make-icons.mjs",
    "desktop:dev": "electron .",
    "desktop:mac": "electron-builder --config desktop/builder.cjs --mac dmg --arm64 --x64",
    "desktop:win": "electron-builder --config desktop/builder.cjs --win nsis --x64 --arm64",
    "desktop:dir": "electron-builder --config desktop/builder.cjs --dir --mac --arm64",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12",
    "sharp": "0.34.5"
  }
}
